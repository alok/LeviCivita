import LeviCivita.Core

/-!
# The field of fractions of an ordered integral domain

`Frac R` is the field of fractions `a / b` (`b ≠ 0`) of a commutative ring `R`
with no zero divisors. If `R` is linearly ordered, so is `Frac R`: `a / b > 0`
iff `a · b > 0`. Everything here is generic and proved without `sorry`.

Applied to `NLC` (finite Levi-Civita sums, which form an ordered integral
domain) this gives `LCFrac := Frac NLC`, an honest **ordered field** that
contains `ε`, `H = ε⁻¹` and every rational power of `ε`, with `Lean.Grind.Field`
and `Lean.Grind.OrderedRing` instances. So `grind` can reason about division by
infinitesimals. `LCFrac` sits inside the Levi-Civita field (it is the subfield
generated by `NLC`); it is not all of it, since `√(1 + ε)` is missing.
-/

namespace LeviCivita.Frac

open Lean.Grind

attribute [local instance] Semiring.natCast Ring.intCast
attribute [local instance high] Semiring.ofNat

/-- An integral domain: a nontrivial commutative ring with no zero divisors. -/
class IsDomain (R : Type u) [CommRing R] : Prop where
  zero_ne_one : (0 : R) ≠ 1
  mul_ne_zero : ∀ {a b : R}, a ≠ 0 → b ≠ 0 → a * b ≠ 0

variable {R : Type u} [CommRing R] [IsDomain R]

theorem cancel_left {d x y : R} (hd : d ≠ 0) (h : d * x = d * y) : x = y := by
  have : d * (x - y) = 0 := by grind
  apply Classical.byContradiction
  intro hne
  exact IsDomain.mul_ne_zero hd (by intro h0; apply hne; grind) this

/-- Pairs `(num, den)` with nonzero denominator. -/
def Pair (R : Type u) [CommRing R] := { p : R × R // p.2 ≠ 0 }

/-- Cross-multiplication. -/
def Rel (x y : Pair R) : Prop := x.val.1 * y.val.2 = y.val.1 * x.val.2

theorem rel_equiv : Equivalence (Rel (R := R)) where
  refl _ := rfl
  symm h := h.symm
  trans {x y z} h1 h2 := by
    unfold Rel at *
    apply cancel_left y.property
    grind

instance setoid (R : Type u) [CommRing R] [IsDomain R] : Setoid (Pair R) := ⟨Rel, rel_equiv⟩

end Frac

open Frac Lean.Grind in
/-- The field of fractions. -/
def Frac (R : Type u) [CommRing R] [IsDomain R] := Quotient (Frac.setoid R)

namespace Frac

open Lean.Grind

attribute [local instance] Semiring.natCast Ring.intCast
attribute [local instance high] Semiring.ofNat

variable {R : Type u} [CommRing R] [IsDomain R]

/-- The fraction `a / b`. -/
def mk (a b : R) (hb : b ≠ 0) : Frac R := Quotient.mk _ ⟨(a, b), hb⟩

theorem mk_eq (a b c d : R) (hb : b ≠ 0) (hd : d ≠ 0) :
    mk a b hb = mk c d hd ↔ a * d = c * b :=
  ⟨Quotient.exact, fun h => Quotient.sound h⟩

theorem ind {P : Frac R → Prop} (h : ∀ a b (hb : b ≠ 0), P (mk a b hb)) (x : Frac R) : P x :=
  Quotient.ind (fun ⟨⟨a, b⟩, hb⟩ => h a b hb) x

private theorem one_ne : (1 : R) ≠ 0 := fun h => IsDomain.zero_ne_one h.symm

instance : Zero (Frac R) := ⟨mk 0 1 one_ne⟩
instance : One (Frac R) := ⟨mk 1 1 one_ne⟩

private def addPair (x y : Pair R) : Pair R :=
  ⟨(x.val.1 * y.val.2 + y.val.1 * x.val.2, x.val.2 * y.val.2),
    IsDomain.mul_ne_zero x.property y.property⟩
private def mulPair (x y : Pair R) : Pair R :=
  ⟨(x.val.1 * y.val.1, x.val.2 * y.val.2), IsDomain.mul_ne_zero x.property y.property⟩
private def negPair (x : Pair R) : Pair R := ⟨(-x.val.1, x.val.2), x.property⟩

private theorem addPair_congr (x y x' y' : Pair R) (h1 : x ≈ x') (h2 : y ≈ y') :
    (Quotient.mk _ (addPair x y) : Frac R) = Quotient.mk _ (addPair x' y') := by
  obtain ⟨⟨a, b⟩, hb⟩ := x; obtain ⟨⟨c, d⟩, hd⟩ := y
  obtain ⟨⟨a', b'⟩, hb'⟩ := x'; obtain ⟨⟨c', d'⟩, hd'⟩ := y'
  have h1 : a * b' = a' * b := h1
  have h2 : c * d' = c' * d := h2
  apply Quotient.sound
  show (a * d + c * b) * (b' * d') = (a' * d' + c' * b') * (b * d)
  grind

private theorem mulPair_congr (x y x' y' : Pair R) (h1 : x ≈ x') (h2 : y ≈ y') :
    (Quotient.mk _ (mulPair x y) : Frac R) = Quotient.mk _ (mulPair x' y') := by
  obtain ⟨⟨a, b⟩, hb⟩ := x; obtain ⟨⟨c, d⟩, hd⟩ := y
  obtain ⟨⟨a', b'⟩, hb'⟩ := x'; obtain ⟨⟨c', d'⟩, hd'⟩ := y'
  have h1 : a * b' = a' * b := h1
  have h2 : c * d' = c' * d := h2
  apply Quotient.sound
  show (a * c) * (b' * d') = (a' * c') * (b * d)
  grind

private theorem negPair_congr (x x' : Pair R) (h : x ≈ x') :
    (Quotient.mk _ (negPair x) : Frac R) = Quotient.mk _ (negPair x') := by
  obtain ⟨⟨a, b⟩, hb⟩ := x; obtain ⟨⟨a', b'⟩, hb'⟩ := x'
  have h : a * b' = a' * b := h
  apply Quotient.sound
  show (-a) * b' = (-a') * b
  grind

instance : Add (Frac R) := ⟨Quotient.lift₂ (fun x y => Quotient.mk _ (addPair x y)) addPair_congr⟩
instance : Mul (Frac R) := ⟨Quotient.lift₂ (fun x y => Quotient.mk _ (mulPair x y)) mulPair_congr⟩
instance : Neg (Frac R) := ⟨Quotient.lift (fun x => Quotient.mk _ (negPair x)) negPair_congr⟩

instance : Sub (Frac R) := ⟨fun x y => x + -y⟩

@[simp] theorem mk_add (a b c d : R) (hb : b ≠ 0) (hd : d ≠ 0) :
    mk a b hb + mk c d hd = mk (a * d + c * b) (b * d) (IsDomain.mul_ne_zero hb hd) := rfl
@[simp] theorem mk_mul (a b c d : R) (hb : b ≠ 0) (hd : d ≠ 0) :
    mk a b hb * mk c d hd = mk (a * c) (b * d) (IsDomain.mul_ne_zero hb hd) := rfl
@[simp] theorem mk_neg (a b : R) (hb : b ≠ 0) : -mk a b hb = mk (-a) b hb := rfl
theorem zero_def : (0 : Frac R) = mk 0 1 one_ne := rfl
theorem one_def : (1 : Frac R) = mk 1 1 one_ne := rfl

theorem mk_eq_zero (a b : R) (hb : b ≠ 0) : mk a b hb = 0 ↔ a = 0 := by
  rw [zero_def, mk_eq]; constructor <;> intro h <;> grind

/-! ### Inverse -/

section Inv
variable [DecidableEq R]

private def invPair (x : Pair R) : Pair R :=
  if h : x.val.1 = 0 then ⟨(0, 1), one_ne⟩ else ⟨(x.val.2, x.val.1), h⟩

private theorem invPair_congr (x y : Pair R) (h : x ≈ y) :
    (Quotient.mk _ (invPair x) : Frac R) = Quotient.mk _ (invPair y) := by
  obtain ⟨⟨a, b⟩, hb⟩ := x
  obtain ⟨⟨c, d⟩, hd⟩ := y
  have h : a * d = c * b := h
  apply Quotient.sound
  unfold invPair
  by_cases ha : a = 0
  · have hc : c = 0 := by
      apply Classical.byContradiction; intro hc
      exact IsDomain.mul_ne_zero hc hb (by rw [← h, ha]; grind)
    simp only [ha, hc, ↓reduceDIte]; exact rel_equiv.refl _
  · have hc : c ≠ 0 := by
      intro hc; exact IsDomain.mul_ne_zero ha hd (by rw [h, hc]; grind)
    simp only [ha, hc, ↓reduceDIte]
    show b * c = d * a; grind

instance : Inv (Frac R) := ⟨Quotient.lift (fun x => Quotient.mk _ (invPair x)) invPair_congr⟩

instance : Div (Frac R) := ⟨fun x y => x * y⁻¹⟩

theorem mk_inv (a b : R) (hb : b ≠ 0) (ha : a ≠ 0) : (mk a b hb)⁻¹ = mk b a ha := by
  show Quotient.mk _ (invPair ⟨(a, b), hb⟩) = _
  unfold invPair; simp only [ha, ↓reduceDIte]; rfl

theorem mk_inv_zero (b : R) (hb : b ≠ 0) : (mk 0 b hb)⁻¹ = 0 := by
  show Quotient.mk _ (invPair ⟨(0, b), hb⟩) = _
  unfold invPair; simp only [↓reduceDIte]; rfl

end Inv

/-! ### Casts, scalar multiples and powers -/

instance : NatCast (Frac R) := ⟨fun n => mk (n : R) 1 one_ne⟩
instance : IntCast (Frac R) := ⟨fun i => mk (i : R) 1 one_ne⟩
instance : OfNat (Frac R) n := ⟨mk (OfNat.ofNat n : R) 1 one_ne⟩
instance : SMul Nat (Frac R) := ⟨fun n x => (n : Frac R) * x⟩
instance : SMul Int (Frac R) := ⟨fun i x => (i : Frac R) * x⟩

/-- Natural powers by repeated multiplication. -/
def npow (x : Frac R) : Nat → Frac R
  | 0 => 1
  | n + 1 => npow x n * x

instance : HPow (Frac R) Nat (Frac R) := ⟨npow⟩

section Zpow
variable [DecidableEq R]

/-- Integer powers. -/
def zpow (x : Frac R) : Int → Frac R
  | .ofNat n => x ^ n
  | .negSucc n => (x ^ (n + 1))⁻¹

instance : HPow (Frac R) Int (Frac R) := ⟨zpow⟩
end Zpow

theorem natCast_def (n : Nat) : (n : Frac R) = mk (n : R) 1 one_ne := rfl
theorem intCast_def (i : Int) : (i : Frac R) = mk (i : R) 1 one_ne := rfl

instance : CommRing (Frac R) where
  add_zero := ind fun a b hb => by
    rw [zero_def, mk_add, mk_eq]; grind
  add_comm := ind fun a b hb => ind fun c d hd => by
    rw [mk_add, mk_add, mk_eq]; grind
  add_assoc := ind fun a b hb => ind fun c d hd => ind fun e f hf => by
    simp only [mk_add]; rw [mk_eq]; grind
  mul_assoc := ind fun a b hb => ind fun c d hd => ind fun e f hf => by
    simp only [mk_mul]; rw [mk_eq]; grind
  mul_one := ind fun a b hb => by
    rw [one_def, mk_mul, mk_eq]; grind
  one_mul := ind fun a b hb => by
    rw [one_def, mk_mul, mk_eq]; grind
  left_distrib := ind fun a b hb => ind fun c d hd => ind fun e f hf => by
    simp only [mk_add, mk_mul]; rw [mk_eq]; grind
  right_distrib := ind fun a b hb => ind fun c d hd => ind fun e f hf => by
    simp only [mk_add, mk_mul]; rw [mk_eq]; grind
  zero_mul := ind fun a b hb => by
    rw [zero_def, mk_mul, mk_eq]; grind
  mul_zero := ind fun a b hb => by
    rw [zero_def, mk_mul, mk_eq]; grind
  pow_zero _ := rfl
  pow_succ _ _ := rfl
  ofNat_succ n := by
    show mk _ 1 one_ne = mk _ 1 one_ne + mk 1 1 one_ne
    rw [mk_add, mk_eq]
    have := Semiring.ofNat_succ (α := R) n
    grind
  ofNat_eq_natCast n := by
    show mk _ 1 one_ne = mk _ 1 one_ne
    rw [Semiring.ofNat_eq_natCast]
  nsmul_eq_natCast_mul _ _ := rfl
  neg_add_cancel := ind fun a b hb => by
    rw [mk_neg, mk_add, zero_def, mk_eq]; grind
  sub_eq_add_neg _ _ := rfl
  neg_zsmul i := ind fun a b hb => by
    show mk _ 1 one_ne * mk a b hb = -(mk _ 1 one_ne * mk a b hb)
    rw [mk_mul, mk_mul, mk_neg, mk_eq, Ring.intCast_neg]; grind
  zsmul_natCast_eq_nsmul n x := by
    show mk _ 1 one_ne * x = mk _ 1 one_ne * x
    rw [Ring.intCast_natCast]
  intCast_ofNat n := by
    show mk _ 1 one_ne = mk _ 1 one_ne
    rw [Ring.intCast_ofNat]
  intCast_neg i := by
    show mk _ 1 one_ne = -mk _ 1 one_ne
    rw [mk_neg, Ring.intCast_neg]
  mul_comm := ind fun a b hb => ind fun c d hd => by
    rw [mk_mul, mk_mul, mk_eq]; grind

private theorem mk_ne_zero {a b : R} (hb : b ≠ 0) (h : mk a b hb ≠ 0) : a ≠ 0 :=
  fun ha => h ((mk_eq_zero a b hb).mpr ha)

instance [DecidableEq R] : Field (Frac R) where
  div_eq_mul_inv _ _ := rfl
  zero_ne_one := by
    rw [zero_def, one_def, Ne, mk_eq]; intro h
    rw [Semiring.mul_one, Semiring.mul_one] at h
    exact IsDomain.zero_ne_one h
  inv_zero := by rw [zero_def, mk_inv_zero]; rfl
  mul_inv_cancel {x} := by
    induction x using ind with
    | h a b hb =>
      intro hx
      have ha := mk_ne_zero hb hx
      rw [mk_inv a b hb ha, mk_mul, one_def, mk_eq]; grind
  zpow_zero _ := rfl
  zpow_succ _ _ := rfl
  zpow_neg x n := by
    match n with
    | .ofNat 0 =>
      show x ^ (0 : Nat) = (x ^ (0 : Nat))⁻¹
      show (1 : Frac R) = 1⁻¹
      rw [one_def, mk_inv 1 1 one_ne one_ne]
    | .ofNat (k + 1) => rfl
    | .negSucc k =>
      show x ^ (k + 1) = ((x ^ (k + 1))⁻¹)⁻¹
      induction x ^ (k + 1) using ind with
      | h a b hb =>
        by_cases ha : a = 0
        · subst ha; rw [mk_inv_zero, zero_def, mk_inv_zero, zero_def, mk_eq]
          rw [Semiring.zero_mul, Semiring.zero_mul]
        · rw [mk_inv a b hb ha, mk_inv b a ha hb]

/-- The embedding `R → Frac R`. -/
def ofRing (a : R) : Frac R := mk a 1 one_ne

theorem ofRing_injective {a b : R} (h : ofRing a = ofRing b) : a = b := by
  have := (mk_eq a 1 b 1 one_ne one_ne).mp h; grind

theorem ofRing_add (a b : R) : ofRing (a + b) = ofRing a + ofRing b := by
  unfold ofRing; rw [mk_add, mk_eq]; grind
theorem ofRing_mul (a b : R) : ofRing (a * b) = ofRing a * ofRing b := by
  unfold ofRing; rw [mk_mul, mk_eq]; grind
theorem ofRing_one : ofRing (1 : R) = 1 := rfl
theorem ofRing_zero : ofRing (0 : R) = 0 := rfl

/-! ### The order -/

section Order
variable [LE R] [LT R] [Std.IsLinearOrder R] [Std.LawfulOrderLT R] [OrderedRing R]

omit [IsDomain R] [Std.LawfulOrderLT R] in
private theorem mul_pos' {a b : R} (ha : 0 < a) (hb : 0 < b) : 0 < a * b := by
  have := OrderedRing.mul_lt_mul_of_pos_left hb ha; grind

omit [IsDomain R] in
private theorem lt_tri (a : R) : a < 0 ∨ a = 0 ∨ 0 < a := by grind

omit [IsDomain R] in
private theorem sq_pos {a : R} (ha : a ≠ 0) : 0 < a * a := by
  rcases lt_tri a with h | h | h
  · have : 0 < -a := by grind
    have := mul_pos' this this; grind
  · exact absurd h ha
  · exact mul_pos' h h

omit [IsDomain R] in
private theorem pos_of_mul_pos {x y : R} (h : 0 < x * y) (hy : 0 < y) : 0 < x := by
  rcases lt_tri x with hx | hx | hx
  · have : 0 < -x := by grind
    have := mul_pos' this hy; grind
  · subst hx; grind
  · exact hx

omit [IsDomain R] in
/-- Positivity of a representative: `0 < a · b`. It respects the relation. -/
private theorem pos_congr {a b c d : R} (hb : b ≠ 0) (hd : d ≠ 0) (h : a * d = c * b)
    (hp : 0 < a * b) : 0 < c * d := by
  -- (c d) b² = (a d)(b d) = (a b) d²
  have e : (c * d) * (b * b) = (a * b) * (d * d) := by
    have : a * d * (b * d) = c * b * (b * d) := by rw [h]
    grind
  have := mul_pos' hp (sq_pos hd)
  rw [← e] at this
  exact pos_of_mul_pos this (sq_pos hb)

/-- `x` is positive. -/
def IsPos (x : Frac R) : Prop :=
  Quotient.liftOn x (fun p => 0 < p.val.1 * p.val.2) (fun ⟨⟨_, _⟩, hb⟩ ⟨⟨_, _⟩, hd⟩ h =>
    propext ⟨pos_congr hb hd h, pos_congr hd hb h.symm⟩)

theorem isPos_mk (a b : R) (hb : b ≠ 0) : IsPos (mk a b hb) ↔ 0 < a * b := Iff.rfl

private theorem isPos_add {x y : Frac R} (hx : IsPos x) (hy : IsPos y) : IsPos (x + y) := by
  induction x using ind with | h a b hb =>
  induction y using ind with | h c d hd =>
  rw [isPos_mk] at hx hy; rw [mk_add, isPos_mk]
  have h1 := mul_pos' hx (sq_pos hd)
  have h2 := mul_pos' hy (sq_pos hb)
  have : (a * d + c * b) * (b * d) = a * b * (d * d) + c * d * (b * b) := by grind
  rw [this]; grind

private theorem isPos_mul {x y : Frac R} (hx : IsPos x) (hy : IsPos y) : IsPos (x * y) := by
  induction x using ind with | h a b hb =>
  induction y using ind with | h c d hd =>
  rw [isPos_mk] at hx hy; rw [mk_mul, isPos_mk]
  have := mul_pos' hx hy
  have e : a * c * (b * d) = a * b * (c * d) := by grind
  rw [e]; exact this

private theorem not_isPos_both (x : Frac R) (h1 : IsPos x) (h2 : IsPos (-x)) : False := by
  induction x using ind with | h a b hb =>
  rw [isPos_mk] at h1; rw [mk_neg, isPos_mk] at h2; grind

private theorem isPos_tri (x : Frac R) : x = 0 ∨ IsPos x ∨ IsPos (-x) := by
  induction x using ind with | h a b hb =>
  rw [mk_neg, isPos_mk, isPos_mk, mk_eq_zero]
  rcases lt_tri (a * b) with h | h | h
  · right; right; grind
  · left; apply Classical.byContradiction; intro ha
    exact IsDomain.mul_ne_zero ha hb h
  · right; left; exact h

private theorem not_isPos_zero : ¬ IsPos (0 : Frac R) := by
  rw [zero_def, isPos_mk]; grind

instance : LT (Frac R) := ⟨fun x y => IsPos (y - x)⟩
instance : LE (Frac R) := ⟨fun x y => x = y ∨ x < y⟩

theorem lt_def (x y : Frac R) : x < y ↔ IsPos (y - x) := Iff.rfl

theorem lt_irrefl (x : Frac R) : ¬ x < x := by
  rw [lt_def]; have : x - x = 0 := by grind
  rw [this]; exact not_isPos_zero

theorem lt_trans {x y z : Frac R} (h1 : x < y) (h2 : y < z) : x < z := by
  rw [lt_def] at *; have : z - x = (z - y) + (y - x) := by grind
  rw [this]; exact isPos_add h2 h1

theorem lt_asymm {x y : Frac R} (h1 : x < y) (h2 : y < x) : False := by
  rw [lt_def] at *; have : x - y = -(y - x) := by grind
  rw [this] at h2; exact not_isPos_both _ h1 h2

theorem lt_trichotomy (x y : Frac R) : x < y ∨ x = y ∨ y < x := by
  rcases isPos_tri (y - x) with h | h | h
  · exact Or.inr (Or.inl (by grind))
  · exact Or.inl h
  · right; right; rw [lt_def]; have : x - y = -(y - x) := by grind
    rw [this]; exact h

instance : Std.IsLinearOrder (Frac R) where
  le_refl _ := Or.inl rfl
  le_trans _ _ _ h1 h2 := by
    rcases h1 with rfl | h1 <;> rcases h2 with rfl | h2
    · exact Or.inl rfl
    · exact Or.inr h2
    · exact Or.inr h1
    · exact Or.inr (lt_trans h1 h2)
  le_antisymm _ _ h1 h2 := by
    rcases h1 with h1 | h1
    · exact h1
    · rcases h2 with h2 | h2
      · exact h2.symm
      · exact (lt_asymm h1 h2).elim
  le_total x y := by
    rcases lt_trichotomy x y with h | h | h
    · exact Or.inl (Or.inr h)
    · exact Or.inl (Or.inl h)
    · exact Or.inr (Or.inr h)

instance : Std.LawfulOrderLT (Frac R) where
  lt_iff x y := by
    constructor
    · intro h
      refine ⟨Or.inr h, ?_⟩
      rintro (h' | h')
      · subst h'; exact lt_irrefl _ h
      · exact lt_asymm h h'
    · rintro ⟨h1 | h1, h2⟩
      · subst h1; exact (h2 (Or.inl rfl)).elim
      · exact h1

instance : OrderedAdd (Frac R) where
  add_le_left_iff {a b} c := by
    have key : b + c - (a + c) = b - a := by grind
    constructor
    · rintro (rfl | h)
      · exact Or.inl rfl
      · exact Or.inr (by rw [lt_def, key]; exact h)
    · rintro (h | h)
      · left; have : a = a + c - c := by grind
        rw [this, h]; grind
      · exact Or.inr (by rw [lt_def, ← key]; exact h)

instance : OrderedRing (Frac R) where
  zero_lt_one := by
    rw [lt_def]; have : (1 : Frac R) - 0 = 1 := by grind
    rw [this, one_def, isPos_mk]
    have := OrderedRing.zero_lt_one (R := R); grind
  mul_lt_mul_of_pos_left {a b c} h hc := by
    rw [lt_def] at *; have : c * b - c * a = (c - 0) * (b - a) := by grind
    rw [this]; exact isPos_mul hc h
  mul_lt_mul_of_pos_right {a b c} h hc := by
    rw [lt_def] at *; have : b * c - a * c = (b - a) * (c - 0) := by grind
    rw [this]; exact isPos_mul h hc

/-- The embedding is strictly monotone: it is an ordered-ring embedding. -/
theorem ofRing_lt {a b : R} : ofRing a < ofRing b ↔ a < b := by
  rw [lt_def]
  have : ofRing b - ofRing a = mk (b - a) 1 one_ne := by
    unfold ofRing; show mk b 1 one_ne + mk (-a) 1 one_ne = _
    rw [mk_add, mk_eq]; grind
  rw [this, isPos_mk]
  constructor <;> intro h <;> grind

end Order

end Frac

/-! ## The Levi-Civita fraction field -/

namespace Core.NLC

open Lean.Grind

instance : Frac.IsDomain NLC where
  zero_ne_one h := by
    have := congrArg (fun x : NLC => x.val.terms.size) h
    simp [LC.zero, LC.one] at this
  mul_ne_zero := mul_ne_zero

end Core.NLC

open Core Frac Lean.Grind

/-- The ordered field generated by finite Levi-Civita sums: quotients `a / b` of
normalized values. It contains `ε`, `H` and `1/(1 + ε)`. -/
abbrev LCFrac := Frac NLC

namespace LCFrac

/-- The infinitesimal `ε`. -/
def eps : LCFrac := ofRing NLC.eps
/-- The infinite `H = ε⁻¹`. -/
def bigH : LCFrac := ofRing NLC.bigH
/-- A rational number. -/
def ofRat (q : Rat) : LCFrac := ofRing (NLC.ofRat q)

theorem eps_pos : 0 < eps := ofRing_lt.mpr NLC.eps_pos
theorem eps_lt_ofRat {q : Rat} (hq : 0 < q) : eps < ofRat q := ofRing_lt.mpr (NLC.eps_lt_ofRat hq)
theorem ofRat_lt_bigH (q : Rat) : ofRat q < bigH := ofRing_lt.mpr (NLC.ofRat_lt_bigH q)
theorem bigH_eq_inv_eps : bigH = eps⁻¹ := by
  have h : eps * bigH = 1 := by
    unfold eps bigH; rw [← ofRing_mul, NLC.eps_mul_bigH]; rfl
  have hne : eps ≠ 0 := fun h0 => by have := eps_pos; rw [h0] at this; grind
  grind

/-- `grind` reasons about the ordered field: division by an infinitesimal. -/
example (x : LCFrac) (hx : x ≠ 0) : x / x = 1 := by grind
example : eps * eps⁻¹ = 1 := by have := eps_pos; grind
example (x : LCFrac) (h : 0 < x) : 0 < x + eps := by have := eps_pos; grind
example (q : Rat) (hq : 0 < q) : eps / 2 < ofRat q := by
  have := eps_lt_ofRat hq; have := eps_pos; grind

end LCFrac

end LeviCivita
